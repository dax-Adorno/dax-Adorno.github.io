---
import "../styles/global.css";
import ProjectsCarousel from "../components/ProjectsCarousel.astro";

const projects = [
  {
    title: "AI Risk Decision Demo",
    desc: "Demo de sistema de apoyo a decisiones basado en IA para evaluación de riesgo, con foco en claridad visual y lectura rápida de resultados.",
    repo: "https://github.com/dax-Adorno/ai-risk-decision-demo",
    media: "/gifs/ai-risk.png",
    stack: ["Python", "Machine Learning", "Data Analysis"],
    demo: ""
  },
  {
    title: "Zoonosis System",
    desc: "Sistema web de gestión con React + TypeScript orientado a administración y operación de flujos reales.",
    repo: "https://github.com/dax-Adorno/zoonosis",
    media: "/gifs/zoonosis.gif",
    stack: ["React", "TypeScript", "Vite"],
    demo: ""
  },
  {
    title: "Python ETL Reporter",
    desc: "Automatización de reportes desde Excel hacia Word con lógica ETL y foco en productividad administrativa.",
    repo: "https://github.com/dax-Adorno/python-etl-reporter",
    media: "/gifs/etl-reporter.gif",
    stack: ["Python", "Pandas", "ETL"],
    demo: ""
  },
  {
    title: "Kotlin Mobile Demo",
    desc: "Aplicación Android desarrollada con Kotlin y Jetpack Compose, pensada para UI moderna y navegación clara.",
    repo: "https://github.com/dax-Adorno/kotlin-mobile-demo",
    media: "/gifs/kotlin-mobile.gif",
    stack: ["Kotlin", "Compose", "Android"],
    demo: ""
  }
];

const featured = projects[0];

const links = {
  github: "https://github.com/dax-Adorno",
  linkedin: "https://www.linkedin.com/in/eduardo-dax-adorno-b-09a7072a2",
  cv: "/cv.pdf",
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eduardo Dax Adorno | Portfolio</title>
    <meta
      name="description"
      content="Portfolio de Eduardo Dax Adorno. Full Stack Developer especializado en Python, React, TypeScript, Kotlin y soluciones aplicadas."
    />
  </head>

  <body class="bg-slate-950 text-white selection:bg-blue-500/30 selection:text-white">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute left-[-12rem] top-[-10rem] h-[34rem] w-[34rem] rounded-full bg-blue-500/10 blur-3xl"></div>
      <div class="absolute right-[-10rem] top-[10rem] h-[28rem] w-[28rem] rounded-full bg-cyan-400/10 blur-3xl"></div>
      <div class="absolute bottom-[-8rem] left-1/3 h-[24rem] w-[24rem] rounded-full bg-indigo-500/10 blur-3xl"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.04),transparent_35%)]"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 py-10">
      <nav class="sticky top-4 z-50 mb-10">
        <div class="mx-auto flex max-w-fit items-center gap-2 rounded-2xl border border-slate-800/80 bg-slate-950/70 px-3 py-3 shadow-[0_10px_40px_rgba(0,0,0,0.45)] backdrop-blur-xl">
          <a href="#home" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white">Inicio</a>
          <a href="#stack" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white">Stack</a>
          <a href="#about" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white">Sobre mí</a>
          <a href="#experience" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white">Experiencia</a>
          <a href="#projects" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white">Proyectos</a>
          <a href="#contact" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white">Contacto</a>
          <a href={links.github} target="_blank" class="rounded-xl bg-blue-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-400">GitHub</a>
        </div>
      </nav>

      <header id="home" class="mb-20 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/70 px-4 py-2 text-sm text-slate-300">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            Full Stack · Python · React · Kotlin · AI Systems
          </p>

          <h1 class="mt-8 max-w-4xl text-5xl font-semibold leading-[1.02] tracking-tight text-white md:text-7xl">
            Construyo productos digitales,
            automatizaciones y soluciones
            <span class="text-blue-400"> con foco real</span>.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">
            Soy Eduardo Dax Adorno, desarrollador full stack. Trabajo con React, TypeScript, Python y Kotlin para crear software útil, escalable y visualmente sólido.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={links.github} target="_blank" class="rounded-xl bg-blue-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-400">
              GitHub
            </a>
            <a href={links.linkedin} target="_blank" class="rounded-xl border border-slate-700 bg-slate-900/70 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
              LinkedIn
            </a>
            <a href={links.cv} target="_blank" class="rounded-xl border border-slate-700 bg-slate-900/70 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
              Descargar CV
            </a>
          </div>
        </div>

        <div class="rounded-[2rem] border border-slate-800 bg-slate-900/60 p-6 shadow-[0_20px_80px_rgba(0,0,0,0.35)] backdrop-blur">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-400/80">
            Snapshot
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
              <p class="text-sm text-slate-400">Proyectos destacados</p>
              <p class="mt-2 text-3xl font-bold text-white">4+</p>
            </div>

            <div class="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
              <p class="text-sm text-slate-400">Foco técnico</p>
              <p class="mt-2 text-3xl font-bold text-white">Web · Data · Mobile</p>
            </div>

            <div class="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
              <p class="text-sm text-slate-400">Especialidad</p>
              <p class="mt-2 text-3xl font-bold text-white">Arquitectura + UX</p>
            </div>

            <div class="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
              <p class="text-sm text-slate-400">Modalidad</p>
              <p class="mt-2 text-3xl font-bold text-white">Remote Ready</p>
            </div>
          </div>
        </div>
      </header>

      <section class="mb-20">
        <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] items-center rounded-[2rem] border border-slate-800 bg-slate-900/60 p-8 shadow-xl">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-400/80">
              Proyecto principal
            </p>

            <h2 class="mt-3 text-4xl font-bold text-white">
              {featured.title}
            </h2>

            <p class="mt-4 max-w-2xl text-slate-400 leading-8">
              {featured.desc}
            </p>

            <div class="mt-5 flex flex-wrap gap-2">
              {featured.stack.map((tech) => (
                <span class="rounded-full border border-slate-700 bg-slate-950/60 px-3 py-1 text-xs text-slate-200">
                  {tech}
                </span>
              ))}
            </div>

            <div class="mt-6 flex gap-3">
              <a
                href={featured.repo}
                target="_blank"
                class="rounded-xl bg-blue-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-400"
              >
                Ver repositorio
              </a>
            </div>
          </div>

          <div class="overflow-hidden rounded-[1.5rem] border border-slate-800 bg-slate-950/70">
            <img
              src={featured.media}
              alt={featured.title}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </section>

      <section id="stack" class="mb-20">
        <div class="mb-10 max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-400/80">
            Stack
          </p>
          <h2 class="mt-3 text-4xl font-bold text-white">Tecnologías con las que construyo</h2>
          <p class="mt-3 text-slate-400 leading-8">
            Trabajo con un stack orientado a frontend moderno, automatización con Python, backend API y desarrollo mobile.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <h3 class="text-lg font-semibold text-blue-400">Frontend</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {["React", "TypeScript", "Vite", "Tailwind", "Axios"].map((tech) => (
                <span class="rounded-full bg-slate-800 px-3 py-1 text-sm text-slate-200">{tech}</span>
              ))}
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <h3 class="text-lg font-semibold text-blue-400">Backend</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {["Python", "FastAPI", "Node.js", "Express", "REST API"].map((tech) => (
                <span class="rounded-full bg-slate-800 px-3 py-1 text-sm text-slate-200">{tech}</span>
              ))}
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <h3 class="text-lg font-semibold text-blue-400">Data & Automation</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {["Pandas", "ETL", "Excel", "Automatización", "Reporting"].map((tech) => (
                <span class="rounded-full bg-slate-800 px-3 py-1 text-sm text-slate-200">{tech}</span>
              ))}
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <h3 class="text-lg font-semibold text-blue-400">Mobile & Dev Tools</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {["Kotlin", "Jetpack Compose", "Git", "GitHub", "VS Code"].map((tech) => (
                <span class="rounded-full bg-slate-800 px-3 py-1 text-sm text-slate-200">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="about" class="mb-20">
        <div class="mb-10 max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-400/80">
            Sobre mí
          </p>
          <h2 class="mt-3 text-4xl font-bold text-white">Perfil técnico con visión de producto</h2>
          <p class="mt-3 text-slate-400 leading-8">
            Me interesa construir software útil, demostrable y bien presentado, cuidando tanto la base técnica como la experiencia de uso.
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-8">
            <h3 class="text-xl font-semibold text-blue-400">Perfil profesional</h3>

            <p class="mt-4 leading-8 text-slate-300">
              Soy desarrollador Full Stack con experiencia en proyectos web, automatización con Python, aplicaciones móviles con Kotlin y soluciones orientadas a procesos reales.
            </p>

            <p class="mt-4 leading-8 text-slate-300">
              Mi trabajo combina frontend moderno, backend, integración con APIs, procesamiento de datos y automatización administrativa mediante herramientas ETL y generación de reportes.
            </p>

            <p class="mt-4 leading-8 text-slate-300">
              También me interesa la aplicación de inteligencia artificial y sistemas de apoyo a la toma de decisiones, integrando modelos, lógica y visualización en productos demostrables.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-8">
            <h3 class="text-xl font-semibold text-blue-400">Fortalezas</h3>

            <div class="mt-5 space-y-4">
              <div class="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                <h4 class="font-semibold text-white">Desarrollo Full Stack</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  Aplicaciones con React, TypeScript, Node.js y estructuras modulares.
                </p>
              </div>

              <div class="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                <h4 class="font-semibold text-white">Automatización & ETL</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  Procesamiento de datos con Python, Excel, Pandas y generación automática de reportes.
                </p>
              </div>

              <div class="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                <h4 class="font-semibold text-white">Mobile Development</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  Interfaces móviles modernas con Kotlin y Jetpack Compose.
                </p>
              </div>

              <div class="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                <h4 class="font-semibold text-white">Visión de producto</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  Capacidad para transformar requerimientos en sistemas claros, funcionales y presentables.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="experience" class="mb-20">
        <div class="mb-10 max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-400/80">
            Experiencia
          </p>
          <h2 class="mt-3 text-4xl font-bold text-white">Proyectos reales y formación aplicada</h2>
          <p class="mt-3 text-slate-400 leading-8">
            Construcción de soluciones web, automatización con Python y desarrollo mobile con foco en entregables reales.
          </p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-8">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <div>
                <h3 class="text-xl font-semibold text-white">
                  Desarrollador Full Stack / Python / Mobile
                </h3>
                <p class="text-blue-400">Proyectos académicos y prácticos</p>
              </div>

              <span class="rounded-full border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm text-slate-300">
                En evolución constante
              </span>
            </div>

            <p class="mt-5 leading-8 text-slate-300">
              Desarrollo de aplicaciones web con React, TypeScript y Vite, automatizaciones con Python orientadas a ETL y generación de reportes, y aplicaciones móviles con Kotlin + Jetpack Compose.
            </p>

            <div class="mt-6 grid gap-4 md:grid-cols-2">
              <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                <h4 class="font-semibold text-white">Web Development</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  Interfaces modernas, autenticación, CRUDs, roles de usuario, consumo de APIs y organización escalable.
                </p>
              </div>

              <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                <h4 class="font-semibold text-white">Python & Automation</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  ETL, Excel, Pandas, generación de reportes y automatización de flujos administrativos.
                </p>
              </div>

              <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                <h4 class="font-semibold text-white">Mobile Development</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  Construcción de aplicaciones Android con Kotlin, Compose y estructura pensada para UX.
                </p>
              </div>

              <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                <h4 class="font-semibold text-white">Applied AI / Decision Systems</h4>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  Demos y conceptos aplicados a soporte de decisiones, análisis de riesgo y automatización inteligente.
                </p>
              </div>
            </div>
          </div>

          <div class="grid gap-6 lg:grid-cols-2">
            <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-8">
              <h3 class="text-xl font-semibold text-blue-400">Formación</h3>

              <div class="mt-6 space-y-5">
                <div>
                  <h4 class="font-semibold text-white">
                    Técnico Superior en Desarrollo de Aplicaciones Web y Móviles
                  </h4>
                  <p class="mt-1 text-sm text-slate-400">
                    Formación orientada a desarrollo de software, arquitectura, bases de datos, mobile y soluciones integrales.
                  </p>
                </div>

                <div>
                  <h4 class="font-semibold text-white">
                    Especialización práctica en Python y automatización
                  </h4>
                  <p class="mt-1 text-sm text-slate-400">
                    ETL, procesamiento de datos, generación de reportes y automatización de tareas.
                  </p>
                </div>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-8">
              <h3 class="text-xl font-semibold text-blue-400">Enfoque profesional</h3>

              <div class="mt-6 space-y-4">
                <div class="flex gap-4">
                  <span class="text-blue-400 font-bold">01</span>
                  <div>
                    <h4 class="font-semibold text-white">Construcción de soluciones reales</h4>
                    <p class="mt-1 text-sm text-slate-400">
                      Priorizo proyectos funcionales, demostrables y alineados a necesidades concretas.
                    </p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <span class="text-blue-400 font-bold">02</span>
                  <div>
                    <h4 class="font-semibold text-white">Orden técnico y mantenibilidad</h4>
                    <p class="mt-1 text-sm text-slate-400">
                      Trabajo con estructuras claras, separación de responsabilidades y foco en escalabilidad.
                    </p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <span class="text-blue-400 font-bold">03</span>
                  <div>
                    <h4 class="font-semibold text-white">Presentación profesional</h4>
                    <p class="mt-1 text-sm text-slate-400">
                      Me interesa que el software no solo funcione, sino que también esté bien presentado y documentado.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <ProjectsCarousel projects={projects} />

      <section id="contact" class="mb-16">
        <div class="rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 p-10 shadow-2xl">
          <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            <div>
              <h2 class="text-3xl font-bold text-white">Contacto</h2>
              <p class="mt-3 max-w-2xl text-slate-400 leading-8">
                Estoy disponible para oportunidades laborales, proyectos freelance y colaboraciones técnicas. Si te interesa mi perfil, podés contactarme directamente por LinkedIn, GitHub o descargar mi CV.
              </p>

              <div class="mt-8 flex flex-wrap gap-3">
                <a href={links.github} target="_blank" class="rounded-xl bg-blue-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-400">
                  GitHub
                </a>

                <a href={links.linkedin} target="_blank" class="rounded-xl border border-slate-700 bg-slate-900/70 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
                  LinkedIn
                </a>

                <a href={links.cv} target="_blank" class="rounded-xl border border-slate-700 bg-slate-900/70 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
                  Descargar CV
                </a>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-800 bg-slate-950/50 p-6">
              <h3 class="text-lg font-semibold text-blue-400">Canales</h3>

              <div class="mt-5 space-y-4">
                <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
                  <p class="text-sm font-semibold text-white">GitHub</p>
                  <a href={links.github} target="_blank" class="mt-2 inline-block text-sm text-slate-400 hover:text-blue-400">
                    github.com/dax-Adorno
                  </a>
                </div>

                <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
                  <p class="text-sm font-semibold text-white">LinkedIn</p>
                  <a href={links.linkedin} target="_blank" class="mt-2 inline-block text-sm text-slate-400 hover:text-blue-400">
                    linkedin.com/in/eduardo-dax-adorno-b-09a7072a2
                  </a>
                </div>

                <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
                  <p class="text-sm font-semibold text-white">CV</p>
                  <a href={links.cv} target="_blank" class="mt-2 inline-block text-sm text-slate-400 hover:text-blue-400">
                    Descargar versión PDF
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </body>
</html>